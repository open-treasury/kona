{
  "name": "@kona/viewer",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "React Flow + dagre over the mutation log. Depends on core ONLY; never on the store.",
  "exports": {
    ".": "./src/server/index.ts"
  },
  "scripts": {
    "css": "tailwindcss -i src/theme.css -o src/styles.css",
    "css:watch": "tailwindcss -i src/theme.css -o src/styles.css --watch",
    "dev": "bun run css && bun run src/server/dev.ts",
    "build": "bun run css && bun build ./index.html --outdir=dist --minify"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@fontsource-variable/crimson-pro": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@kona/core": "workspace:*",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-tooltip": "1.2.16",
    "@xyflow/react": "12.11.3",
    "clsx": "2.1.1",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tailwind-variants": "3.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7"
  }
}
