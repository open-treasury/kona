{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "promise",
    "import"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off"
  },
  "rules": {
    "eslint/no-console": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-misused-promises": "error",
    "import/no-cycle": "error",
    "eslint/no-await-in-loop": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-conversion": "error"
  },
  "ignorePatterns": [
    ".claude",
    "node_modules",
    ".stryker-tmp",
    "reports",
    "docs",
    "fixtures"
  ],
  "overrides": [
    {
      "files": [
        "packages/core/src/**/*.ts"
      ],
      "rules": {
        "eslint/no-restricted-globals": [
          "error",
          {
            "name": "process",
            "message": "core is pure (SPEC 6.12): no process. Take what you need as an argument."
          },
          {
            "name": "Bun",
            "message": "core is pure (SPEC 6.12): no runtime globals."
          },
          {
            "name": "fetch",
            "message": "core is pure (SPEC 6.12): no I/O."
          }
        ],
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "node:*",
                  "fs",
                  "path",
                  "os",
                  "crypto"
                ],
                "message": "core is pure (SPEC 6.12): the kona package is the only thing that writes."
              }
            ]
          }
        ],
        "eslint/no-restricted-properties": [
          "error",
          {
            "object": "Date",
            "property": "now",
            "message": "core is pure (SPEC 6.8): every verb is a function of the log + THE CLOCK PASSED IN."
          },
          {
            "object": "Math",
            "property": "random",
            "message": "core is deterministic: a fold must reproduce byte for byte."
          }
        ]
      }
    },
    {
      "files": [
        "packages/kona/src/bin.ts"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "demo/**/*.ts"
      ],
      "rules": {
        "eslint/no-console": "off"
      }
    },
    {
      "files": [
        "**/test/**/*.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/await-thenable": "off"
      }
    }
  ]
}
