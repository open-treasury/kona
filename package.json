{
  "name": "kona-monorepo",
  "private": true,
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "skills": [
      "./plugin/skills/copy",
      "./plugin/skills/prd",
      "./plugin/skills/spec",
      "./plugin/skills/issues"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc -p packages/core && tsc -p packages/kona && tsc -p packages/viewer && tsc -p eval && bun run typecheck:purity",
    "typecheck:purity": "tsc -p packages/core/tsconfig.purity.json",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "test": "bun test",
    "plugin:build": "node plugin/scripts/build.mjs",
    "plugin:validate": "node plugin/scripts/validate.mjs",
    "test:plugin": "node --test plugin/test/*.node.mjs && bun test plugin/test/*.test.ts",
    "mutate": "./scripts/mutation.sh",
    "check": "bun run typecheck && bun run lint && bun run knip && bun run test",
    "mutate:core": "STRYKER_TIER=core stryker run stryker.conf.mjs",
    "mutate:durability": "STRYKER_TIER=durability stryker run stryker.conf.mjs",
    "mutate:rest": "STRYKER_TIER=rest stryker run stryker.conf.mjs",
    "mutate:outbox": "STRYKER_TIER=outbox stryker run stryker.conf.mjs"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@types/bun": "latest",
    "knip": "6.32.2",
    "oxfmt": "0.66.0",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  }
}
